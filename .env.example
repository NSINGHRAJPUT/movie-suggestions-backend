# Port the Express API listens on.
# NOTE: 5000 is commonly reserved by macOS AirPlay Receiver (Control Center),
# which will silently swallow requests without the driver ever raising a
# port-in-use error. If requests to the API mysteriously hang/404, either
# disable AirPlay Receiver in System Settings > General > AirDrop & Handoff,
# or just use a different port (5001, 8000, ...) as below.
PORT=5001

# CognoDB Cloud connection (Bolt protocol over TLS).
COGNODB_URI=bolt+s://YOUR_INSTANCE.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=YOUR_PASSWORD

# Comma-separated list of origins allowed to call this API (CORS).
FRONTEND_ORIGIN=http://localhost:3000

# development | production
NODE_ENV=development
